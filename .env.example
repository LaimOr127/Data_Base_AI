# DIGroup Configuration
# Скопируйте этот файл в .env и измените значения

# Секретный код доступа (минимум 16 символов)
ACCESS_AUTH_CODE=b226ba0f30a134fe9245792118bca202

# Часовой пояс
TZ=Europe/Moscow

# Порт для kernel (внутренний, через Nginx)
KERNEL_PORT=6806

# Домен (если есть)
DOMAIN=digroup.yourdomain.com

# Email для Let's Encrypt (для SSL)
SSL_EMAIL=admin@yourdomain.com
