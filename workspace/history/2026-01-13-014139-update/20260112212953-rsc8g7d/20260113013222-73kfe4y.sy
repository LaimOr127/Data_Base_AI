10 % lower"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Reasoning depth"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Better on multi‑step logical puzzles"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Comparable on single‑step tasks"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Cost per inference"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"~ 1.3× higher"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Baseline"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Use‑case fit"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"High‑precision domains (medicine, finance)"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"General‑purpose chatbots, cost‑sensitive apps"}]}]}]},{"ID":"20260113013523-x4m7v03","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-x4m7v03","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"8. Getting Started (quick steps)"}]},{"ID":"20260113013523-80qicvq","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113013523-80qicvq","updated":"20260113013523"},"Children":[{"ID":"20260113013523-4g2sdi1","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260113013523-4g2sdi1","updated":"20260113013523"},"Children":[{"ID":"20260113013523-chdeb83","Type":"NodeParagraph","Properties":{"id":"20260113013523-chdeb83","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Create an NVIDIA NGC account"},{"Type":"NodeText","Data":" (if you don’t already have one)."}]}]},{"ID":"20260113013523-28lk8w6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260113013523-28lk8w6","updated":"20260113013523"},"Children":[{"ID":"20260113013523-tsb45em","Type":"NodeParagraph","Properties":{"id":"20260113013523-tsb45em","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Request access"},{"Type":"NodeText","Data":" to the "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nemotron-3-45b-cloud"},{"Type":"NodeText","Data":"​ model in the NGC Catalog."}]}]},{"ID":"20260113013523-4a3bow0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260113013523-4a3bow0","updated":"20260113013523"},"Children":[{"ID":"20260113013523-5a1fyx6","Type":"NodeParagraph","Properties":{"id":"20260113013523-5a1fyx6","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Generate an API key"},{"Type":"NodeText","Data":" in the NGC portal."}]}]},{"ID":"20260113013523-6xf8d21","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260113013523-6xf8d21","updated":"20260113013523"},"Children":[{"ID":"20260113013523-kko3c5t","Type":"NodeParagraph","Properties":{"id":"20260113013523-kko3c5t","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Set up the inference client"},{"Type":"NodeText","Data":" (Python example below):"}]}]}]},{"ID":"20260113013523-lzofpsz","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113013523-lzofpsz","updated":"20260113013523"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import requests\nimport json\n\nAPI_URL = \"https://api.nvidia.com/v1/models/nvidia/nemotron-3-45b-cloud/infer\"\nAPI_KEY = \"YOUR_NVIDIA_API_KEY\"\n\nheaders = {\n    \"Authorization\": f\"Bearer {API_KEY}\",\n    \"Content-Type\": \"application/json\"\n}\n\npayload = {\n    \"prompt\": \"Explain quantum tunneling in simple terms.\",\n    \"max_tokens\": 200,\n    \"temperature\": 0.7,\n    \"top_p\": 0.95\n}\n\nresponse = requests.post(API_URL, headers=headers, json=payload)\nresult = response.json()\n\nprint(result[\"choices\"][0][\"text\"])\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113013523-uo98x32","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113013523-uo98x32","updated":"20260113013523"},"Children":[{"ID":"20260113013523-3utsjdc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20260113013523-3utsjdc","updated":"20260113013523"},"Children":[{"ID":"20260113013523-5ulkqna","Type":"NodeParagraph","Properties":{"id":"20260113013523-5ulkqna","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Monitor usage"},{"Type":"NodeText","Data":" via the NGC dashboard to stay within your allocated quota or to upgrade to a higher‑throughput tier."}]}]}]},{"ID":"20260113013523-rd79ykw","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-rd79ykw","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"9. Limitations \u0026 Caveats"}]},{"ID":"20260113013523-afhkp0q","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-afhkp0q","updated":"20260113013523"},"Children":[{"ID":"20260113013523-x3bbd3w","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-x3bbd3w","updated":"20260113013523"},"Children":[{"ID":"20260113013523-woxgczn","Type":"NodeParagraph","Properties":{"id":"20260113013523-woxgczn","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Context length:"},{"Type":"NodeText","Data":" 4096 tokens (≈ 3000 words). Longer documents must be chunked or summarized."}]}]},{"ID":"20260113013523-r7odwwa","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-r7odwwa","updated":"20260113013523"},"Children":[{"ID":"20260113013523-184csp5","Type":"NodeParagraph","Properties":{"id":"20260113013523-184csp5","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Real‑time constraints:"},{"Type":"NodeText","Data":" For ultra‑low‑latency (≤ 100 ms) scenarios, edge‑deployment requires exporting the model to TensorRT‑LLM and running on local GPUs; the cloud API adds network overhead (~ 30‑50 ms)."}]}]},{"ID":"20260113013523-a6n1rph","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-a6n1rph","updated":"20260113013523"},"Children":[{"ID":"20260113013523-aydn7y9","Type":"NodeParagraph","Properties":{"id":"20260113013523-aydn7y9","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Data freshness:"},{"Type":"NodeText","Data":" The model’s knowledge cutoff is "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"June 2024"},{"Type":"NodeText","Data":"; it cannot retrieve events after that date without query‑time retrieval."}]}]},{"ID":"20260113013523-v3slc20","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-v3slc20","updated":"20260113013523"},"Children":[{"ID":"20260113013523-2hr3cdd","Type":"NodeParagraph","Properties":{"id":"20260113013523-2hr3cdd","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Ethical risks:"},{"Type":"NodeText","Data":" While safety filters are robust, no system is perfect; user‑level overrides can be configured for tighter control in regulated industries."}]}]}]},{"ID":"20260113013523-8cxk4ve","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-8cxk4ve","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"10. Where to Find More Info"}]},{"ID":"20260113013523-k0uu7xr","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-k0uu7xr","updated":"20260113013523"},"Children":[{"ID":"20260113013523-p5fme7i","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-p5fme7i","updated":"20260113013523"},"Children":[{"ID":"20260113013523-b5m19v4","Type":"NodeParagraph","Properties":{"id":"20260113013523-b5m19v4","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Model Card:"},{"Type":"NodeText","Data":" https://huggingface.co/nvidia/nemotron-3-45b-cloud"}]}]},{"ID":"20260113013523-t9ift0v","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-t9ift0v","updated":"20260113013523"},"Children":[{"ID":"20260113013523-8pkfad4","Type":"NodeParagraph","Properties":{"id":"20260113013523-8pkfad4","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Technical Whitepaper:"},{"Type":"NodeText","Data":" “Nemotron‑3: Scaling Multilingual Reasoning with Cloud‑Native Inference” (NVIDIA, March 2025) – downloadable from the NVIDIA Research site."}]}]},{"ID":"20260113013523-bcq94dd","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-bcq94dd","updated":"20260113013523"},"Children":[{"ID":"20260113013523-zzxrh2b","Type":"NodeParagraph","Properties":{"id":"20260113013523-zzxrh2b","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Community Forum:"},{"Type":"NodeText","Data":" https://forums.developer.nvidia.com/c/nemotron/"}]}]}]},{"ID":"20260113013523-2regvkh","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-2regvkh","updated":"20260113013523"}},{"ID":"20260113013523-uvigwcf","Type":"NodeParagraph","Properties":{"id":"20260113013523-uvigwcf","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Bottom line:"},{"Type":"NodeText","Data":" If you need a high‑capacity, multilingual, and safety‑aware LLM with strong reasoning abilities and are prepared to work within a managed cloud API environment, Nemotron‑3‑45B‑Cloud is the flagship offering. It outperforms the 30 B version on most benchmark suites but comes with higher cost and infrastructure requirements."}]}]}