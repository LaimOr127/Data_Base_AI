60113013523"},"Children":[{"ID":"20260113013523-kr9be34","Type":"NodeParagraph","Properties":{"id":"20260113013523-kr9be34","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Content moderation:"},{"Type":"NodeText","Data":" Built‑in classifier to filter disallowed outputs (e.g., hate, self‑harm, extremist propaganda)."}]}]},{"ID":"20260113013523-fbjafn2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-fbjafn2","updated":"20260113013523"},"Children":[{"ID":"20260113013523-cio7avb","Type":"NodeParagraph","Properties":{"id":"20260113013523-cio7avb","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Fact‑checking hooks:"},{"Type":"NodeText","Data":" Integrated with an external retrieval‑augmented system that can surface citations from up‑to‑date verified sources (e.g., Wikipedia, DAQ, arXiv)."}]}]},{"ID":"20260113013523-etluge0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-etluge0","updated":"20260113013523"},"Children":[{"ID":"20260113013523-duiryl0","Type":"NodeParagraph","Properties":{"id":"20260113013523-duiryl0","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Alignment techniques:"},{"Type":"NodeText","Data":" Fine‑tuned with RLHF and a custom safety loss that penalizes harmful or stereotypical generations."}]}]}]},{"ID":"20260113013523-u5hax6a","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-u5hax6a","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"5. Access \u0026 Licensing"}]},{"ID":"20260113013523-kcx7ndd","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-kcx7ndd","updated":"20260113013523"},"Children":[{"ID":"20260113013523-bf33t9o","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"i