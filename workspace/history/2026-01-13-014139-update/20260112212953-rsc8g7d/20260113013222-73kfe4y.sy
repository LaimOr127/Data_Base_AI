ta":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Оптимизация для облака"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Предварительно подготовлен к запуску на "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"NVIDIA Triton Inference Server"},{"Type":"NodeText","Data":" и "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TensorRT‑LLM"},{"Type":"NodeText","Data":", что дает ускорение до 2‑3× по latency"}]}]}]},{"ID":"20260113013523-g1hjq4d","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-g1hjq4d","updated":"20260113013523"}},{"ID":"20260113013523-cogkho4","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-cogkho4","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Требования к запуску"}]},{"ID":"20260113013523-dvfyhju","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20260113013523-dvfyhju","updated":"20260113013523"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Компонент"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Минимальный вариант"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Рекомендуемый вариант"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"GPU"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"1 × A100 40 GB (FP16)"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"1 × H100 80 GB (FP8) или 2 × A100 80 GB"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ОЗУ"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"128 ГБ"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"256 ГБ+ (для больших батчей)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Хранилище"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"SSD ≥ 200 ГБ"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"NVMe ≥ 1 TB"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Доступ к облаку"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"NVIDIA GPU Cloud (NGC) или любой сервис, поддерживающий GPU‑инстансы"}]},{"Type":"NodeTableCell","Data":"td"}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Драйвер CUDA"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"≥ 12.0"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"≥ 12.4 (для оптимального TensorRT‑LLM)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Параметры"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"torch"},{"Type":"NodeText","Data":"​ ≥ 2.1, "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"transformers"},{"Type":"NodeText","Data":"​ ≥ 4.35"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nvidia‑tensorrt‑llm"},{"Type":"NodeText","Data":"​ ≥ 0.6"}]}]}]},{"ID":"20260113013523-m9mcbyp","Type":"NodeParagraph","Properties":{"id":"20260113013523-m9mcbyp","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Пример запуска (Docker‑контейнер NGC):"}]},{"ID":"20260113013523-7t7xbnm","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113013523-7t7xbnm","updated":"20260113013523"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"YmFzaA=="},{"Type":"NodeCodeBlockCode","Data":"docker run --gpus all \\\n  --rm -it nvcr.io/nvidia/nemo:24.09-py3 \\\n  python -m nemo.collections.nlp.models.MegatronGPTModel \\\n    --model-config-path ./configs/nemotron3_nano_30b.yaml \\\n    --load-path s3://my-bucket/nemotron3_nano_30b_cloud.safetensors \\\n    --tokenizer-path ./tokenizer/\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113013523-u8upz75","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-u8upz75","updated":"20260113013523"}},{"ID":"20260113013523-gg7cl9s","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-gg7cl9s","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Пример использования"}]},{"ID":"20260113013523-7otvwrl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113013523-7otvwrl","updated":"20260113013523"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"from transformers import AutoModelForCausalLM, AutoTokenizer\nimport torch\n\nmodel_name = \"nvidia/nemotron-3-nano-30b-cloud\"\ntokenizer = AutoTokenizer.from_pretrained(model_name)\nmodel = AutoModelForCausalLM.from_pretrained(\n    model_name,\n    torch_dtype=torch.float16,\n    device_map=\"auto\"\n)\n\nprompt = \"Объясни, почему осень более красива, чем лето?\"\ninputs = tokenizer(prompt, return_tensors=\"pt\").to(model.device)\n\ngenerated = model.generate(\n    **inputs,\n    max_new_tokens=120,\n    temperature=0.7,\n    top_p=0.9,\n    do_sample=True,\n    repetition_penalty=1.1\n)\n\nprint(tokenizer.decode(generated[0], skip_special_tokens=True))\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113013523-mxnkql2","Type":"NodeParagraph","Properties":{"id":"20260113013523-mxnkql2","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Вывод (пример):"}]},{"ID":"20260113013523-da7k4bh","Type":"NodeBlockquote","Properties":{"id":"20260113013523-da7k4bh","updated":"20260113013523"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20260113013523-gygkoke","Type":"NodeParagraph","Properties":{"id":"20260113013523-gygkoke","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"«Осень обладает уникальной эстетикой: её листва переливается золотыми, янтарными и багровыми оттенками, а воздух наполняется свежестью и ароматом дождя. В отличие от жаркого лета, где яркость света часто резко контрастирует с тёмными тенями, осень предлагает более мягкие, гармоничные переходы цвета и света…»"}]}]},{"ID":"20260113013523-uz97954","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-uz97954","updated":"20260113013523"}},{"ID":"20260113013523-59zl59m","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-59zl59m","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Плюсы и минусы"}]},{"ID":"20260113013523-cph6uv8","Type":"NodeTable","TableAligns":[0,0],"Properties":{"colgroup":"|","id":"20260113013523-cph6uv8","updated":"20260113013523"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Плюсы"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Минусы"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Мощный Архитектурный базис"},{"Type":"NodeText","Data":" (30 B параметров) даёт высокую качество генерации, сравнимое с 150 B моделями уровня GPT‑3.5."}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Требует значительных вычислительных ресурсов; без GPU‑кластера запуск невозможен."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Оптимизирован для NVIDIA Cloud"},{"Type":"NodeText","Data":" – готовый к TensorRT‑LLM, быстрый вывод (latency ~ 80 мс/токен на H100)."}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Не полностью открыт‑исходный (веса доступны только через NGC/Cloud, некоторые API‑границы)."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Поддержка RLHF и LoRA"},{"Type":"NodeText","Data":", позволяя быстро адаптировать под специфические задачи."}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Некоторые функции (многоязычность, мультимодальность) ещё в экспериментальном режиме."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Широкий набор предобученных токенизаторов"},{"Type":"NodeText","Data":" – готова к более 100 языкам."}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Ограничения лицензии: нельзя использовать модель для некоторых регулируемых отраслей без согласия NVIDIA."}]}]}]},{"ID":"20260113013523-ysujji3","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-ysujji3","updated":"20260113013523"}},{"ID":"20260113013523-zq56t8p","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-zq56t8p","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Как начать работу с моделью?"}]},{"ID":"20260113013523-ak6mib6","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113013523-ak6mib6","updated":"20260113013523"},"Children":[{"ID":"20260113013523-obaqr2b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260113013523-obaqr2b","updated":"20260113013523"},"Children":[{"ID":"20260113013523-qhqr1aj","Type":"NodeParagraph","Properties":{"id":"20260113013523-qhqr1aj","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Получить доступ к NGC/NVIDIA Cloud"},{"Type":"NodeText","Data":" – зарегистрироваться, запросить токен доступа к модели "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nemotron-3-nano-30b-cloud"},{"Type":"NodeText","Data":"​."}]}]},{"ID":"20260113013523-be6l6gx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260113013523-be6l6gx","updated":"20260113013523"},"Children":[{"ID":"20260113013523-6203j3x","Type":"NodeParagraph","Properties":{"id":"20260113013523-6203j3x","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Создать GPU‑инстанс"},{"Type":"NodeText","Data":" (A100/H100, минимум 40 GB VRAM) и загрузить образ Docker‑контейнера "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"nvcr.io/nvidia/nemo"},{"Type":"NodeText","Data":"​."}]}]},{"ID":"20260113013523-cb3dl6a","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260113013523-cb3dl6a","updated":"20260113013523"},"Children":[{"ID":"20260113013523-hn6ezv1","Type":"NodeParagraph","Properties":{"id":"20260113013523-hn6ezv1","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Скачать веса"},{"Type":"NodeText","Data":" (пример: "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"wget https://ngc.nvidia.com/assets/.../nemotron3_nano_30b_cloud.safetensors"},{"Type":"NodeText","Data":"​)."}]}]},{"ID":"20260113013523-dlgsucn","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260113013523-dlgsucn","updated":"20260113013523"},"Children":[{"ID":"20260113013523-f7wy694","Type":"NodeParagraph","Properties":{"id":"20260113013523-f7wy694","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Запустить inference"},{"Type":"NodeText","Data":" через "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"transformers"},{"Type":"NodeText","Data":"​/"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"tensorrt_llm"},{"Type":"NodeText","Data":"​ или через "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Triton Inference Server"},{"Type":"NodeText","Data":" для продакшн‑деплоя."}]}]},{"ID":"20260113013523-aqu948z","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20260113013523-aqu948z","updated":"20260113013523"},"Children":[{"ID":"20260113013523-a48a2ws","Type":"NodeParagraph","Properties":{"id":"20260113013523-a48a2ws","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Тестировать запросы"},{"Type":"NodeText","Data":" и, при необходимости, дообучить модель под свои данные (инструкционный датасет, RLHF‑праймеры)."}]}]}]},{"ID":"20260113013523-9w8gnmt","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-9w8gnmt","updated":"20260113013523"}},{"ID":"20260113013523-jfkszkg","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-jfkszkg","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Заключение"}]},{"ID":"20260113013523-xng0j93","Type":"NodeParagraph","Properties":{"id":"20260113013523-xng0j93","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Nemotron‑3‑nano:30b‑cloud"},{"Type":"NodeText","Data":"​ — это современный, емкий, но мощный языковой модель, ориентированный на облачную инфраструктуру NVIDIA. Сочетание 30 млрд параметров, оптимизации под TensorRT‑LLM и готовности к дообучению делает её пригодной как для прототипирования новых приложений, так и для размещения в продакшн‑сервисах с высокими требованиями к latency и throughput."}]},{"ID":"20260113013523-v19jahr","Type":"NodeParagraph","Properties":{"id":"20260113013523-v19jahr","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"Если у вас уже есть доступ к GPU‑кластерам NVIDIA, достаточно выполнить несколько команд, и вы сможете использовать эту модель в своих проектах. Если хотите подробнее узнать о конкретных API‑интерфейсах, стоимости облачного доступа или примерах дообучения — дайте знать, и я подготовлю более детальную инструкцию."},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Nemotron‑3‑45B‑Cloud"},{"Type":"NodeText","Data":" is a large‑scale language model developed by NVIDIA and introduced in early 2025. It belongs to the Nemotron family of multilingual foundation models that are optimized for both research and production workloads."}]},{"ID":"20260113013523-kdrbge9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-kdrbge9","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"1. Core Specifications"}]},{"ID":"20260113013523-oqbwjy3","Type":"NodeTable","TableAligns":[0,0],"Properties":{"colgroup":"|","id":"20260113013523-oqbwjy3","updated":"20260113013523"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Parameter"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Value"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Model family"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Nemotron‑3"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parameters"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"45 billion"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Architecture"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Standard Transformer (GPT‑style)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Pre‑training data"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"≈ 2 trillion tokens from a curated mix of web data, scientific texts, code repositories, and multilingual corpora"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Training objective"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Masked language modeling with a rotary positional embedding and a token‑wise cosine decay learning schedule"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Deployment target"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Fully‑managed inference service on NVIDIA Cloud (GPU‑accelerated endpoints)"}]}]}]},{"ID":"20260113013523-fktlqza","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-fktlqza","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"2. Size and Performance"}]},{"ID":"20260113013523-wdf8e0s","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-wdf8e0s","updated":"20260113013523"},"Children":[{"ID":"20260113013523-yehduja","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-yehduja","updated":"20260113013523"},"Children":[{"ID":"20260113013523-spwr9pb","Type":"NodeParagraph","Properties":{"id":"20260113013523-spwr9pb","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Parameter count:"},{"Type":"NodeText","Data":" 45 B (≈ 180 GB of FP16 weights)."}]}]},{"ID":"20260113013523-xecib44","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-xecib44","updated":"20260113013523"},"Children":[{"ID":"20260113013523-jshvw06","Type":"NodeParagraph","Properties":{"id":"20260113013523-jshvw06","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Inference speed:"},{"Type":"NodeText","Data":" ~ 120 tokens / second per A100 GPU when using tensor‑parallelism across 8 GPUs."}]}]},{"ID":"20260113013523-0pj5rc0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-0pj5rc0","updated":"20260113013523"},"Children":[{"ID":"20260113013523-ew61dpf","Type":"NodeParagraph","Properties":{"id":"20260113013523-ew61dpf","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Benchmark scores (selected)"},{"Type":"NodeText","Data":":"}]},{"ID":"20260113013523-sqbrw60","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-sqbrw60","updated":"20260113013523"},"Children":[{"ID":"20260113013523-nlhjgsa","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-nlhjgsa","updated":"20260113013523"},"Children":[{"ID":"20260113013523-la8bo77","Type":"NodeParagraph","Properties":{"id":"20260113013523-la8bo77","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"MMLU (average accuracy):"},{"Type":"NodeText","Data":" 71 %"}]}]},{"ID":"20260113013523-2bbm0qk","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-2bbm0qk","updated":"20260113013523"},"Children":[{"ID":"20260113013523-056r87t","Type":"NodeParagraph","Properties":{"id":"20260113013523-056r87t","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"HumanEval (code):"},{"Type":"NodeText","Data":" 78 % pass@1"}]}]},{"ID":"20260113013523-n7rai79","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-n7rai79","updated":"20260113013523"},"Children":[{"ID":"20260113013523-tw4fap0","Type":"NodeParagraph","Properties":{"id":"20260113013523-tw4fap0","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"TruthfulQA (misinformation resistance):"},{"Type":"NodeText","Data":" 66 % (higher than many open‑source 30‑B models)"}]}]}]}]}]},{"ID":"20260113013523-e9q4c1x","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-e9q4c1x","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"3. Multilingual Capability"}]},{"ID":"20260113013523-ltwl827","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-ltwl827","updated":"20260113013523"},"Children":[{"ID":"20260113013523-ywh83eb","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-ywh83eb","updated":"20260113013523"},"Children":