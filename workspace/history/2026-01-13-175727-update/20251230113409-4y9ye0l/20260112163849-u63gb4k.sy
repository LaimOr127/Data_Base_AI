part, Sotheby’s Auto)."}]}]},{"ID":"20260113175156-hjl3nn2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-hjl3nn2","updated":"20260113175156"},"Children":[{"ID":"20260113175156-scq1qiy","Type":"NodeParagraph","Properties":{"id":"20260113175156-scq1qiy","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"Публичные данные (фискальные расценки, статистика продаж)."}]}]}]}]}]}]},{"ID":"20260113175156-sv2bgty","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-sv2bgty","updated":"20260113175156"},"Children":[{"ID":"20260113175156-61joaja","Type":"NodeParagraph","Properties":{"id":"20260113175156-61joaja","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Типы алгоритмов"}]},{"ID":"20260113175156-qs7x30a","Type":"NodeList","ListData":{},"Properties":{"id":"20260113175156-qs7x30a","updated":"20260113175156"},"Children":[{"ID":"20260113175156-f7zmpwa","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-f7zmpwa","updated":"20260113175156"},"Children":[{"ID":"20260113175156-0l0a0f3","Type":"NodeParagraph","Properties":{"id":"20260113175156-0l0a0f3","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Опциональные подходы"},{"Type":"NodeText","Data":":"}]},{"ID":"20260113175156-fq9151w","Type":"NodeList","ListData":{},"Properties":{"id":"20260113175156-fq9151w","updated":"20260113175156"},"Children":[{"ID":"20260113175156-wj43huh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-wj43huh","updated":"20260113175156"},"Children":[{"ID":"20260113175156-zd7v7fb","Type":"NodeParagraph","Properties":{"id":"20260113175156-zd7v7fb","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"Метод сравнения с аналогами (аналогичные автомобили с 