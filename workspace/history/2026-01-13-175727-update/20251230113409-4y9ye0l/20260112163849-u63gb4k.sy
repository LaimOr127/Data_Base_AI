ed":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Экспорт/Поделиться"},{"Type":"NodeText","Data":" – «Сохранить PDF», «Отправить заявку продавцу»."}]}]},{"ID":"20260113175156-b884hzp","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OS4=","Num":9},"Properties":{"id":"20260113175156-b884hzp","updated":"20260113175156"},"Children":[{"ID":"20260113175156-5o1uzx0","Type":"NodeParagraph","Properties":{"id":"20260113175156-5o1uzx0","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"История"},{"Type":"NodeText","Data":" – «Мои предыдущие оценки», сравнение с рынком."}]}]}]},{"ID":"20260113175156-kue43xe","Type":"NodeThematicBreak","Properties":{"id":"20260113175156-kue43xe","updated":"20260113175156"}},{"ID":"20260113175156-dgguhw1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113175156-dgguhw1","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"4️⃣ Модели данных (примерные схемы)"}]},{"ID":"20260113175156-958ss0m","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113175156-958ss0m","updated":"20260113175156"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"c3Fs"},{"Type":"NodeCodeBlockCode","Data":"-- Пользователь\nCREATE TABLE users (\n    id UUID PRIMARY KEY,\n    email VARCHAR UNIQUE NOT NULL,\n    password_hash TEXT,\n    created_at TIMESTAMP DEFAULT now(),\n    role VARCHAR CHECK (role IN ('USER','ADMIN')) DEFAULT 'USER'\n);\n\n-- Автомобиль (по VIN)\nCREATE TABLE vin_lookup (\n    vin VARCHAR(17) PRIMARY KEY,\n    make VARCHAR NOT NULL,\n    model VARCHAR NOT NULL,\n    year INT NOT NULL,\n    trim VARCHAR,\n    body_type VARCHAR,\n    engine VARCHAR,\n    ...               -- любые внешние атрибуты\n);\n\n-- Оценка\nCREATE TABLE appraisal (\n    id UUID PRIMARY KEY,\n    user_id UUID REFERENCES users(id),\n    vin VARCHAR(17) REFERENCES vin_lookup(vin),\n    created_at TIMESTAMP DEFAULT now(),\n    score NUMERIC(12,2),               -- полученная цена\n    confidence NUMERIC(4,3),           -- 0.0‑1.0\n    raw_features JSONB,                -- все промежуточные коэффициенты\n    report_url TEXT,                   -- S3 link\n    status VARCHAR CHECK (status IN ('PENDING','COMPLETED','FAILED')) DEFAULT 'PENDING'\n);\n\n-- Рекомендации (таблица правил)\nCREATE TABLE repair_impact (\n    issue VARCHAR NOT NULL,\n    cost_increase_percent NUMERIC(5,2), -- пример\n    PRIMARY KEY (issue)\n);\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113175156-ghefs5k","Type":"NodeParagraph","Properties":{"id":"20260113175156-ghefs5k","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"report_url"},{"Type":"NodeText","Data":"​ хранит ссылку на готовый PDF (генерируется сервером, подписан S3 URL)."}]},{"ID":"20260113175156-3zthgg1","Type":"NodeThematicBreak","Properties":{"id":"20260113175156-3zthgg1","updated":"20260113175156"}},{"ID":"20260113175156-5tvtlng","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113175156-5tvtlng","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5️⃣ Оценка стоимости: математический фундамент"}]},{"ID":"20260113175156-7z6z6fm","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-7z6z6fm","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5.1 Базовая цена (BC)"}]},{"ID":"20260113175156-rknrbh8","Type":"NodeParagraph","Properties":{"id":"20260113175156-rknrbh8","updated":"20260113175156"},"Children":[{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\nBC = \\text{ReferencePrice}(make, model, year, trim)\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]}]},{"ID":"20260113175156-oo90mzp","Type":"NodeParagraph","Properties":{"id":"20260113175156-oo90mzp","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"ReferencePrice берётся из публичных баз (AutoScout24 API, OLX‑price‑trend), агрегируется по году/региону."}]},{"ID":"20260113175156-peyqgtv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-peyqgtv","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5.2 Коэффициент износа (CI)"}]},{"ID":"20260113175156-1pko0fz","Type":"NodeParagraph","Properties":{"id":"20260113175156-1pko0fz","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"Для каждой категорической характеристики (скалы, глубина царапин, уровень износа салона) предсказывает модель:\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\nCI = \\sum_{i} w_i \\cdot f_i(\\text{фото}_i)\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]}]},{"ID":"20260113175156-y3r55lm","Type":"NodeParagraph","Properties":{"id":"20260113175156-y3r55lm","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"w_i"},{"Type":"NodeText","Data":"​ – вес, полученный обучением на исторических данных; "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"f_i"},{"Type":"NodeText","Data":"​ – встроенный классификатор (CNN → вероятность «повреждения»)."}]},{"ID":"20260113175156-2u8qiei","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-2u8qiei","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5.3 Коэффициент пробега (CP)"}]},{"ID":"20260113175156-qej25k4","Type":"NodeParagraph","Properties":{"id":"20260113175156-qej25k4","updated":"20260113175156"},"Children":[{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\nCP = \\exp\\bigl(-\\alpha \\cdot \\frac{km - \\mu_{km}}{σ_{km}}\\bigr)\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]},{"Type":"NodeText","Data":"\nгде "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":" \\mu_{km}, σ_{km} "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":" – средние/стандартные отклонения пробегов в соседнем сегменте."}]},{"ID":"20260113175156-857ourf","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-857ourf","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5.4 Региональный коэффициент (CR)"}]},{"ID":"20260113175156-g48ca7j","Type":"NodeParagraph","Properties":{"id":"20260113175156-g48ca7j","updated":"20260113175156"},"Children":[{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\nCR = \\frac{\\text{Рынок}_{regional"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"avg}}{\\text{Рынок}_{national"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"avg}}\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]}]},{"ID":"20260113175156-onrnsa2","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-onrnsa2","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"5.5 Итоговая формула"}]},{"ID":"20260113175156-ribtmwd","Type":"NodeParagraph","Properties":{"id":"20260113175156-ribtmwd","updated":"20260113175156"},"Children":[{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\n\\text{Price}_{\\text{final}} = BC \\cdot (1 + CI) \\cdot CP \\cdot CR \\cdot \\text{AdjFactor}\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]}]},{"ID":"20260113175156-s5a9qt0","Type":"NodeParagraph","Properties"