етевых интерфейсов, кода для ИИ‑объектов"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"10"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Эволюция доставки"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Дроны‑логистика + подводные трубы + человек‑курьер «пакетов»"}]}]}]},{"ID":"20260113012640-xxjp71j","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-xxjp71j","updated":"20260113012640"}},{"ID":"20260113012640-p8bmhmq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-p8bmhmq","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"📚 Как превратить мозговой штурм в конкретный план действий"}]},{"ID":"20260113012640-xdnt29l","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113012640-xdnt29l","updated":"20260113012640"},"Children":[{"ID":"20260113012640-98129z8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260113012640-98129z8","updated":"20260113012640"},"Children":[{"ID":"20260113012640-wyqcofo","Type":"NodeParagraph","Properties":{"id":"20260113012640-wyqcofo","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Собери все идеи"},{"Type":"NodeText","Data":" – не отсекай сразу, просто запиши всё в один список/мейнд‑карту."}]}]},{"ID":"20260113012640-gy7lcjm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260113012640-gy7lcjm","updated":"20260113012640"},"Children":[{"ID":"20260113012640-1eorj4a","Type":"NodeParagraph","Properties":{"id":"20260113012640-1eorj4a","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Классифицируй"},{"Type":"NodeText","Data":" – раздели на категории (технические, марк