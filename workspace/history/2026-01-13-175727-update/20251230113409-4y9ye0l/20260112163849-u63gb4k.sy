"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Кофе‑пауза"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"«Питаем ли мы людей «энергией» в их рабочий день?», «Какие «паузы» нам стоит планировать для роста идей?»"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Лабиринт"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"«Как построить систему, где каждый пользователь может «выбирать» свой собственный путь развития?», «Какие «выхода» мы предоставляем, чтобы идеи не застревали?»"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Космос"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"«Какие «границы» мы готовы пересекать?», «Как шupiter (Юпитер) может символизировать масштабный рост?»"}]}]}]},{"ID":"20260113012640-iiddhlk","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-iiddhlk","updated":"20260113012640"}},{"ID":"20260113012640-fgghzo5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-fgghzo5","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"7. «Экспериментальная карта»"}]},{"ID":"20260113012640-gk795mz","Type":"NodeParagraph","Properties":{"id":"20260113012640-gk795mz","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Составьте небольшую карту убеждений, где каждый пункт — плюс/минус, и ищите места, где плюсы «перепрыгивают» над минусами:"}]},{"ID":"20260113012640-xsva2u3","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113012640-xsva2u3","updated":"20260113012640"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"+ Высокая скорость тестирования → – Недостаточная проверка качества\n↔ Привлечение ранних пользователей → ↑ Возможные юридические проблемы\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113012640-91dvxfw","Type":"NodeParagraph","Properties":{"id":"20260113012640-91dvxfw","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Ищите "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"«мост»"},{"Type":"NodeText","Data":" — элемент, который одновременно усиливает плюс и уменьшает минус (например, автоматизированные проверки CI/CD могут снизить риск, одновременно ускоряя релизы)."}]},{"ID":"20260113012640-xgwgnhe","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-xgwgnhe","updated":"20260113012640"}},{"ID":"20260113012640-ymsgstl","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-ymsgstl","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"8. «Борьба с яблоком»"}]},{"ID":"20260113012640-k91cvu8","Type":"NodeParagraph","Properties":{"id":"20260113012640-k91cvu8","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Запишите "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"три"},{"Type":"NodeText","Data":" самых «тяжёлых» препятствий, которые у вас сейчас стоят. Затем задайте им вопрос:"}]},{"ID":"20260113012640-vrzabof","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-vrzabof","updated":"20260113012640"},"Children":[{"ID":"20260113012640-jyh667q","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-jyh667q","updated":"20260113012640"},"Children":[{"ID":"20260113012640-4a49jto","Type":"NodeParagraph","Properties":{"id":"20260113012640-4a49jto","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Что будет, если я сделаю их"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong em","TextMarkTextContent":"незначительными"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"?"}]}]},{"ID":"20260113012640-ee6ohcf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-ee6ohcf","updated":"20260113012640"},"Children":[{"ID":"20260113012640-vyfhe3v","Type":"NodeParagraph","Properties":{"id":"20260113012640-vyfhe3v","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Что они"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong em","TextMarkTextContent":"дающее"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"мне, если я позволю им влиять?"}]}]}]},{"ID":"20260113012640-dgj424b","Type":"NodeParagraph","Properties":{"id":"20260113012640-dgj424b","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Часто яблоко выглядит большим только в восприятии; рассадить его в ряд мелких «задач» показывает новые пути обхода."}]},{"ID":"20260113012640-jr4ddtn","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-jr4ddtn","updated":"20260113012640"}},{"ID":"20260113012640-wpb604u","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012640-wpb604u","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Как использовать"}]},{"ID":"20260113012640-p6bjz6s","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113012640-p6bjz6s","updated":"20260113012640"},"Children":[{"ID":"20260113012640-svb2757","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260113012640-svb2757","updated":"20260113012640"},"Children":[{"ID":"20260113012640-d1aet73","Type":"NodeParagraph","Properties":{"id":"20260113012640-d1aet73","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Выберите один из пунктов"},{"Type":"NodeText","Data":" (или несколько) — не нужно делать всё сразу."}]}]},{"ID":"20260113012640-153ku6q","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260113012640-153ku6q","updated":"20260113012640"},"Children":[{"ID":"20260113012640-degajoh","Type":"NodeParagraph","Properties":{"id":"20260113012640-degajoh","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Задайте себе/команде конкретный вопрос"},{"Type":"NodeText","Data":" из выбранного блока."}]}]},{"ID":"20260113012640-uvyzr32","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260113012640-uvyzr32","updated":"20260113012640"},"Children":[{"ID":"20260113012640-zxu0tie","Type":"NodeParagraph","Properties":{"id":"20260113012640-zxu0tie","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Запишите ответы"},{"Type":"NodeText","Data":" (в голове, в блокноте, в цифровом документе)."}]}]},{"ID":"20260113012640-6unajlm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260113012640-6unajlm","updated":"20260113012640"},"Children":[{"ID":"20260113012640-u23pd90","Type":"NodeParagraph","Properties":{"id":"20260113012640-u23pd90","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Найдите «якорь»"},{"Type":"NodeText","Data":" — одну идею, которая кажется более интересной, чем предыдущая."}]}]},{"ID":"20260113012640-wp74vn2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20260113012640-wp74vn2","updated":"20260113012640"},"Children":[{"ID":"20260113012640-mxqk9rk","Type":"NodeParagraph","Properties":{"id":"20260113012640-mxqk9rk","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Продолжайте развивать её"},{"Type":"NodeText","Data":", используя приемы «перекраска», «контрастный вопрос» и т.д."}]}]}]},{"ID":"20260113012640-0a654zg","Type":"NodeParagraph","Properties":{"id":"20260113012640-0a654zg","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Если хотите, можете поделиться конкретным вопросом, над которым вы работаете, и я помогу «прокачать» её дальше! 🚀Конечно, давайте создадим мозговой штурм! Вот несколько идей, которые помогут вам продвинуться вперёд. Если у вас уже есть конкретная задача или тема, напишите её — уточним детали, а я помогу с идеями."}]},{"ID":"20260113012640-z7xz1q0","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-z7xz1q0","updated":"20260113012640"}},{"ID":"20260113012640-7yqtiss","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012640-7yqtiss","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"🔍 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Ситуация: Философский дилемма для бизнеса"}]},{"ID":"20260113012640-mt9wed9","Type":"NodeParagraph","Properties":{"id":"20260113012640-mt9wed9","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Проблема:"},{"Type":"NodeText","Data":"\nКомпания-стартап в сфере экологичных технологий (например, упаковка из биоразлагаемых материалов) сталкивается с конфликтом:"}]},{"ID":"20260113012640-m6fvxvq","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-m6fvxvq","updated":"20260113012640"},"Children":[{"ID":"20260113012640-5ss69sg","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-5ss69sg","updated":"20260113012640"},"Children":[{"ID":"20260113012640-ke6ffj7","Type":"NodeParagraph","Properties":{"id":"20260113012640-ke6ffj7","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Стратегия A:"},{"Type":"NodeText","Data":" Отказ от использования текущих поставщиков (которые работают с дешевыми, но неэкологичными материалами), чтобы перейти на 100% устойчивые решения."}]}]},{"ID":"20260113012640-56x4doc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-56x4doc","updated":"20260113012640"},"Children":[{"ID":"20260113012640-xy6rq7i","Type":"NodeParagraph","Properties":{"id":"20260113012640-xy6rq7i","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Стратегия B:"},{"Type":"NodeText","Data":" Сохранить старых поставщиков, но добавить небольшой «зелёный» аспект в их продукцию (например, добавить 10% переработанного материала)."}]}]}]},{"ID":"20260113012640-kwrioxw","Type":"NodeParagraph","Properties":{"id":"20260113012640-kwrioxw","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Вопрос для мозгового штурма:"},{"Type":"NodeText","Data":"\nКак сохранить экологические ценности бизнеса, не теряя при этом финансовой устойчивости?\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Подсказка:"},{"Type":"NodeText","Data":" Учесть не только экологию, но и социальные риски (например, протесты клиентов, если они узнают о «ложной экологичности» поставщиков)."}]},{"ID":"20260113012640-pjw336d","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-pjw336d","updated":"20260113012640"}},{"ID":"20260113012640-i92qmoj","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012640-i92qmoj","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"💡 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Варианты идей (для вдохновения):"}]},{"ID":"20260113012640-4q59ikh","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260113012640-4q59ikh","updated":"20260113012640"},"Children":[{"ID":"20260113012640-t9608l3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260113012640-t9608l3","updated":"20260113012640"},"Children":[{"ID":"20260113012640-74snbzi","Type":"NodeParagraph","Properties":{"id":"20260113012640-74snbzi","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Дилемма как функция в приложении в реальном времени:"},{"Type":"NodeText","Data":"\nРеализуйте интерфейс, где пользователи видят, насколько их выбор влияет на экологию (например, «Вы выбрали упаковку с 50% переработанным материалом — это сэкономит 10 кг CO₂»).\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Плюс:"},{"Type":"NodeText","Data":" Увеличивает вовлечённость и прозрачность.\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Минус:"},{"Type":"NodeText","Data":" Требует дорогостоящего маркетинга и точных данных."}]}]},{"ID":"20260113012640-5zmypu4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260113012640-5zmypu4","updated":"20260113012640"},"Children":[{"ID":"20260113012640-n85y2f7","Type":"NodeParagraph","Properties":{"id":"20260113012640-n85y2f7","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Партнёрство с этическими брендами:"},{"Type":"NodeText","Data":"\nПилотный проект: сотрудничество с 3 малыми экологичными компаниями (например, локальными фермами или производителями биоразлагаемых материалов), чтобы создать «зеленую сеть поставок».\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Плюс:"},{"Type":"NodeText","Data":" Снижает риски, создаёт новые возможности.\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Минус:"},{"Type":"NodeText","Data":" Долгий запуск (но может стать уникальным продающим пунктом)."}]}]},{"ID":"20260113012640-dgc6jy5","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260113012640-dgc6jy5","updated":"20260113012640"},"Children":[{"ID":"20260113012640-visyucg","Type":"NodeParagraph","Properties":{"id":"20260113012640-visyucg","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"«Зелёный взнос» от клиентов:"},{"Type":"NodeText","Data":"\nКлиенты платят небольшую дополнительную сумму за «зелёный пакет» (например, +5% от цены), а эти деньги идут на оплату перехода на устойчивые материалы.\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Плюс:"},{"Type":"NodeText","Data":" Снижает давление на бюджет.\n"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Минус:"},{"Type":"NodeText","Data":" Требует убедительности в маркетинге, чтобы клиенты не восприняли это как «наживу»."}]}]}]},{"ID":"20260113012640-qoso5lw","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-qoso5lw","updated":"20260113012640"}},{"ID":"20260113012640-qi14aci","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012640-qi14aci","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"🚀 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Совет от мозгового штурма:"}]},{"ID":"20260113012640-3ydpecd","Type":"NodeParagraph","Properties":{"id":"20260113012640-3ydpecd","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Не стоит выбирать только один путь. Попробуйте комбинировать идеи:"}]},{"ID":"20260113012640-c9anpq1","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-c9anpq1","updated":"20260113012640"},"Children":[{"ID":"20260113012640-wpvxk0u","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-wpvxk0u","updated":"20260113012640"},"Children":[{"ID":"20260113012640-pviy2v2","Type":"NodeParagraph","Properties":{"id":"20260113012640-pviy2v2","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Начните с небольшого пилотного проекта (например, партнёрство с 1-2 устойчивыми поставщиками), чтобы показать реальные результаты."}]}]},{"ID":"20260113012640-yrwtb8k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-yrwtb8k","updated":"20260113012640"},"Children":[{"ID":"20260113012640-y6urbtx","Type":"NodeParagraph","Properties":{"id":"20260113012640-y6urbtx","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Используйте данные из пилота для обоснования полного перехода (например, «Наши клиенты готовы платить на 15% больше за экологичную упаковку» → тогда переход станет выгодным)."}]}]}]},{"ID":"20260113012640-bycez4z","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-bycez4z","updated":"20260113012640"}},{"ID":"20260113012640-1h04nxa","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012640-1h04nxa","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"❓ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Вопрос для вас:"}]},{"ID":"20260113012640-pcfpfps","Type":"NodeParagraph","Properties":{"id":"20260113012640-pcfpfps","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Есть ли у вас уже есть идея, на которой хотите сосредоточиться? Например:"}]},{"ID":"20260113012640-iokcgw8","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-iokcgw8","updated":"20260113012640"},"Children":[{"ID":"20260113012640-xkpsysl","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-xkpsysl","updated":"20260113012640"},"Children":[{"ID":"20260113012640-3rtnt2k","Type":"NodeParagraph","Properties":{"id":"20260113012640-3rtnt2k","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Тема (технологии, экология, образование и т.д.)?"}]}]},{"ID":"20260113012640-5bt7m6n","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-5bt7m6n","updated":"20260113012640"},"Children":[{"ID":"20260113