 - Market APIs (AutoScout24, Auto.ru)\n│   - Γрафический API (OpenStreetMap)\n└─────────────────────────────┘\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113175156-ixikdgg","Type":"NodeParagraph","Properties":{"id":"20260113175156-ixikdgg","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Тех. Stack (простота запуска)"}]},{"ID":"20260113175156-ur9jnbj","Type":"NodeList","ListData":{},"Properties":{"id":"20260113175156-ur9jnbj","updated":"20260113175156"},"Children":[{"ID":"20260113175156-dbzdyuw","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-dbzdyuw","updated":"20260113175156"},"Children":[{"ID":"20260113175156-euylequ","Type":"NodeParagraph","Properties":{"id":"20260113175156-euylequ","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Frontend:"},{"Type":"NodeText","Data":" React + TypeScript + MUI (или TailwindCSS)."}]}]},{"ID":"20260113175156-sc9y0qm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-sc9y0qm","updated":"20260113175156"},"Children":[{"ID":"20260113175156-sy8pncw","Type":"NodeParagraph","Properties":{"id":"20260113175156-sy8pncw","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Backend:"},{"Type":"NodeText","Data":" FastAPI (Python 3.11) + Pydantic + async DB (SQLalchemy)."}]}]},{"ID":"20260113175156-gy0cowi","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113175156-gy0cowi","updated":"20260113175156"},"Children":[{"ID":"20260113175156-jvdn972","Type":"NodeParagraph","Properties":{"id":"20260113175156-jvdn972","updated":"20260113175156"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"ML‑serving:"},{"Type":"NodeText","Data":" TorchServe (для CV) + FastAPI wrappe