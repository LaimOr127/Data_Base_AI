k","updated":"20260113175156"}},{"ID":"20260113175156-y2jme4h","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-y2jme4h","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"8. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Дорожная карта (MVP → Production)"}]},{"ID":"20260113175156-7vapd6w","Type":"NodeParagraph","Properties":{"id":"20260113175156-7vapd6w","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"| Выпуск | Ключевые задачи | Примечание |\n|--------|----------------|-------------|\n| "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"MVP (1‑2 мес)"},{"Type":"NodeText","Data":" | • Frontend‑форма ввода\n• Backend‑endpoint "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"/estimate"},{"Type":"NodeText","Data":"​\n• Базовая линейная модель цены (правила + фиксированные коэффициенты)\n• UI‑отображение цены и базовых рекомендаций | Фокус на согласовании с «партнёрами‑ставителями» (тестировщик‑пользователь). |\n| "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Beta (3‑4 мес)"},{"Type":"NodeText","Data":" | • Интеграция VIN‑декодера\n• Хранилище исторических объявлений для верификации\n• Кеширование в Redis\n• Деплой в облаке (AWS/Azure/GCP)\n• Тесты на нагрузочность | На этом этапе собираем обратную связь, прорабатываем drift‑детекцию. |\n| "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Production (6 мес)"},{"Type":"NodeText","Data":" | • Переход на ML‑модель (XGBoost)\n• Долгосрочное обучение/обновление моделей\n• Мониторинг и алерты\n• Доработка UI (history‑graph, сравнение)\n• PL‑платёж / Freemium‑платформы | Публичный релиз, маркетинговая кампания, SLA = 99.9% uptime. |\n| "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Экспансия (12 мес+)"},{"Type":"NodeText","Data":" | • Добавление оценки для друга‑платформ (lease, rent)\n• Многоязычный UI (RU/EN/DE)\n• API‑лицензии для B2B\n• Интеграция с CRM‑и‑ERP‑системами | Выход на международные рынки, построение экосистемы. |"}]},{"ID":"20260113175156-17jls07","Type":"NodeThematicBreak","Properties":{"id":"20260113175156-17jls07","updated":"20260113175156"}},{"ID":"20260113175156-anwxcu0","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113175156-anwxcu0","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"9. "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Оценка рисков и тайм‑лайн"}]},{"ID":"20260113175156-og5l6ff","Type":"NodeTable","TableAligns":[0,0],"Properties":{"colgroup":"|","id":"20260113175156-og5l6ff","updated":"20260113175156"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Риск"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Как смягчить"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Недостаточное/смещённое обучающее множество"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Партнёрство с несколькими крупными автодилерами, открытый парсинг объявлений, ранняя проверка распределения признаков."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Большие вычисления в реальном времени"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Кешировать результаты, использовать pre‑computed модели, распределённый inference через AWS Lambda/Cloud Run."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Низкая точность в редких регионах"}]},{"Type":"No