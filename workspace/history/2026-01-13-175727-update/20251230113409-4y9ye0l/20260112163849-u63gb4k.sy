a":": Почему проблема существует? Почему её нельзя решить? И так 5 раз."}]}]}]},{"ID":"20260113012640-3rj2swx","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-3rj2swx","updated":"20260113012640"}},{"ID":"20260113012640-52goeu1","Type":"NodeParagraph","Properties":{"id":"20260113012640-52goeu1","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Пришлите свою задачу, и мы начнем! 🚀"}]},{"ID":"20260113012716-192lszy","Type":"NodeParagraph","Properties":{"id":"20260113012716-192lszy","updated":"20260113012716"}},{"ID":"20260113012717-hzxroje","Type":"NodeParagraph","Properties":{"id":"20260113012717-hzxroje","updated":"20260113012758"},"Children":[{"Type":"NodeText","Data":"Расскажи мне про закон Ньютона"}]},{"ID":"20260113012804-twdz3ga","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113012804-twdz3ga","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Краткое резюме закона Ньютона"}]},{"ID":"20260113012804-s29i2f6","Type":"NodeParagraph","Properties":{"id":"20260113012804-s29i2f6","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1. Первое закон (закон инерции)"}]},{"ID":"20260113012804-kchuflk","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-kchuflk","updated":"20260113012804"},"Children":[{"ID":"20260113012804-wa65xse","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-wa65xse","updated":"20260113012804"},"Children":[{"ID":"20260113012804-d0z06ww","Type":"NodeParagraph","Properties":{"id":"20260113012804-d0z06ww","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Суть:"},{"Type":"NodeText","Data":" Тело сохраняет состояние покоя или равномерного прямолинейного движения, если на него не действуют силы со стороны."}]}]},{"ID":"20260113012804-5uwm0tv","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-5uwm0tv","updated":"20260113012804"},"Children":[{"ID":"20260113012804-jl4hl6r","Type":"NodeParagraph","Properties":{"id":"20260113012804-jl4hl6r","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Формула (не численная):"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Если сумма всех внешних сил, действующих на тело, равна нулю ("},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"(\\sum \\vec F = \\vec 0)"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"), то ускорение тела равно нулю ("},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"(\\vec a = \\vec 0)"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":")."}]}]},{"ID":"20260113012804-q69i71g","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-q69i71g","updated":"20260113012804"},"Children":[{"ID":"20260113012804-4bts466","Type":"NodeParagraph","Properties":{"id":"20260113012804-4bts466","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Что значит:"},{"Type":"NodeText","Data":" Без внешних воздействий движение не меняется – если тело покоится, оно останется покоись; если движется, оно продолжит двигаться с той же скоростью и в том же направлении."}]}]}]},{"ID":"20260113012804-in68k0g","Type":"NodeParagraph","Properties":{"id":"20260113012804-in68k0g","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"2. Второе закон (закон динамики)"}]},{"ID":"20260113012804-ztg2sgm","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-ztg2sgm","updated":"20260113012804"},"Children":[{"ID":"20260113012804-z42guvt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-z42guvt","updated":"20260113012804"},"Children":[{"ID":"20260113012804-nntspca","Type":"NodeParagraph","Properties":{"id":"20260113012804-nntspca","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Суть:"},{"Type":"NodeText","Data":" Ускорение тела прямо пропорционально силе и обратно пропорционально его массе."}]}]},{"ID":"20260113012804-dhtl6wu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-dhtl6wu","updated":"20260113012804"},"Children":[{"ID":"20260113012804-2vfk357","Type":"NodeParagraph","Properties":{"id":"20260113012804-2vfk357","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Формула:"},{"Type":"NodeText","Data":" "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\n\\sum \\vec F = m "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":","}]},{"Type":"NodeText","Data":"\\vec a\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]},{"Type":"NodeText","Data":"\nгде "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\vec F"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":" – вектор суммы всех внешних сил, "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"m"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":" – масса тела, "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\vec a"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":" – ускорение."}]}]},{"ID":"20260113012804-jpwydfo","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-jpwydfo","updated":"20260113012804"},"Children":[{"ID":"20260113012804-0p74a1u","Type":"NodeParagraph","Properties":{"id":"20260113012804-0p74a1u","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Пояснение:"},{"Type":"NodeText","Data":" Сила толкает (ускоряет) тело; чем тяжелее тело, тем меньше оно ускоряется при той же силе."}]}]}]},{"ID":"20260113012804-jaj991t","Type":"NodeParagraph","Properties":{"id":"20260113012804-jaj991t","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3. Третье закон (закон действия‑противодействия)"}]},{"ID":"20260113012804-s0uv0m3","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-s0uv0m3","updated":"20260113012804"},"Children":[{"ID":"20260113012804-o2pk585","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-o2pk585","updated":"20260113012804"},"Children":[{"ID":"20260113012804-tvx6k0e","Type":"NodeParagraph","Properties":{"id":"20260113012804-tvx6k0e","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Суть:"},{"Type":"NodeText","Data":" Для каждойAction (действие) существует равноправная противоположная реакция."}]}]},{"ID":"20260113012804-lt90176","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-lt90176","updated":"20260113012804"},"Children":[{"ID":"20260113012804-r3gffyu","Type":"NodeParagraph","Properties":{"id":"20260113012804-r3gffyu","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Формула:"},{"Type":"NodeText","Data":" "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"["}]},{"Type":"NodeText","Data":"\n\\vec F_{12} = -\\vec F_{21}\n"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"]"}]},{"Type":"NodeText","Data":"\n«Силы,”— действие тела 1 на тело 2 ("},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\vec F_{12}"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":") и действие тела 2 на тело 1 ("},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\vec F_{21}"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":") — равны по модулю и противоположны по направлению."}]}]},{"ID":"20260113012804-m6t1zq1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-m6t1zq1","updated":"20260113012804"},"Children":[{"ID":"20260113012804-s3lrz3s","Type":"NodeParagraph","Properties":{"id":"20260113012804-s3lrz3s","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Последствия:"},{"Type":"NodeText","Data":" При контакте тела взаимно «толкают» друг друга равными силами; это объясняет, как движется ракета, как человек ходит, как колёса контактируют с землёй."}]}]}]},{"ID":"20260113012804-5bjwmci","Type":"NodeThematicBreak","Properties":{"id":"20260113012804-5bjwmci","updated":"20260113012804"}},{"ID":"20260113012804-ak4tod3","Type":"NodeHeading","HeadingLevel":4,"Properties":{"id":"20260113012804-ak4tod3","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Как запомнить"}]},{"ID":"20260113012804-hsxvpyc","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-hsxvpyc","updated":"20260113012804"},"Children":[{"ID":"20260113012804-03ag0xn","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-03ag0xn","updated":"20260113012804"},"Children":[{"ID":"20260113012804-yieyaz7","Type":"NodeParagraph","Properties":{"id":"20260113012804-yieyaz7","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Первый закон"},{"Type":"NodeText","Data":" – «инерция», наблюдаемое отсутствие изменения движения без внешних сил."}]}]},{"ID":"20260113012804-7ak7v4g","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-7ak7v4g","updated":"20260113012804"},"Children":[{"ID":"20260113012804-i51gyy2","Type":"NodeParagraph","Properties":{"id":"20260113012804-i51gyy2","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Второй закон"},{"Type":"NodeText","Data":" – «сила = масса × ускорение», количественная связь."}]}]},{"ID":"20260113012804-z4r2g8m","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-z4r2g8m","updated":"20260113012804"},"Children":[{"ID":"20260113012804-ywf38mf","Type":"NodeParagraph","Properties":{"id":"20260113012804-ywf38mf","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Третий закон"},{"Type":"NodeText","Data":" – «каждая сила имеет равноправную и противоположную реакцию», взаимные взаимодействия."}]}]}]},{"ID":"20260113012804-a5qc6h3","Type":"NodeParagraph","Properties":{"id":"20260113012804-a5qc6h3","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Эти три принципа формируют основу классической механики и позволяют анализировать поведение большинства повседневных и инженерных систем."},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Резюме: Закон Ньютона (правила движения)"}]},{"ID":"20260113012804-6u3v4m6","Type":"NodeParagraph","Properties":{"id":"20260113012804-6u3v4m6","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent