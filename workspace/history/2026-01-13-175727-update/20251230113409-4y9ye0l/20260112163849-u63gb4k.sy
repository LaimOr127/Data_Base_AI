осов, подходов и артефактов, которые помогут сформулировать полный план проекта – от концепции до готового продукта. Мы разбил всё на 6 ключевых блоков, каждый из которых снабжён подзадачами, инсайтами и рекомендациями."}]},{"ID":"20260113175156-wog9o59","Type":"NodeThematicBreak","Properties":{"id":"20260113175156-wog9o59","updated":"20260113175156"}},{"ID":"20260113175156-fmf2jt8","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113175156-fmf2jt8","updated":"20260113175156"},"Children":[{"Type":"NodeText","Data":"1️⃣ ПОМЕХИЧЕСКИЙ СТРОК (Product Vision → Success Metrics)"}]},{"ID":"20260113175156-dafm5kp","Type":"NodeTable","TableAligns":[0,0,0,0],"Properties":{"colgroup":"|||","id":"20260113175156-dafm5kp","updated":"20260113175156"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Шаг"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Что делаем"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Ключевые вопросы"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Артефакт"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"1.1"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Формулируем "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Vision"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Что мы хотим решить? Для кого? Какой уровень точности меняет правила игры?"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"1‑карточка Vision (короткое описание, «Problem‑Solution Fit»)"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkT