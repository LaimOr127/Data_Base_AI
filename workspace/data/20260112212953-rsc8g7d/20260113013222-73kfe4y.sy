3523"},"Children":[{"ID":"20260113013523-hvm857f","Type":"NodeParagraph","Properties":{"id":"20260113013523-hvm857f","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Supported languages:"},{"Type":"NodeText","Data":" 105+ languages, spanning Latin, Cyrillic, Arabic, Devanagari, and East Asian scripts."}]}]},{"ID":"20260113013523-o4ahwvh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-o4ahwvh","updated":"20260113013523"},"Children":[{"ID":"20260113013523-x19d8qe","Type":"NodeParagraph","Properties":{"id":"20260113013523-x19d8qe","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Language‑specific performance:"},{"Type":"NodeText","Data":" Top‑tier performance on European and East Asian languages; still strong on low‑resource languages thanks to the mixed‑corpus pre‑training strategy."}]}]},{"ID":"20260113013523-8c0ixgj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-8c0ixgj","updated":"20260113013523"},"Children":[{"ID":"20260113013523-ixjm6we","Type":"NodeParagraph","Properties":{"id":"20260113013523-ixjm6we","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Code proficiency:"},{"Type":"NodeText","Data":" Trained on ~ 1 trillion tokens of source code (multiple languages, major frameworks)."}]}]}]},{"ID":"20260113013523-2594ybr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113013523-2594ybr","updated":"20260113013523"},"Children":[{"Type":"NodeText","Data":"4. Safety and Alignment"}]},{"ID":"20260113013523-3zfd8bf","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-3zfd8bf","updated":"20260113013523"},"Children":[{"ID":"20260113013523-owvb4sj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-owvb4