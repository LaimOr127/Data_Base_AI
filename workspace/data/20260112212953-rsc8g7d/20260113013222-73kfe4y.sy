"20260113015621"},"Children":[{"ID":"20260113015621-q64s3mx","Type":"NodeParagraph","Properties":{"id":"20260113015621-q64s3mx","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Дефицит или деформация дистрофина ослабляют связь между сателлитными клетками и мышечными волокнами, делая их уязвимыми к механическому стрессу."}]}]},{"ID":"20260113015621-8txgbvw","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260113015621-8txgbvw","updated":"20260113015621"},"Children":[{"ID":"20260113015621-c6wgwgv","Type":"NodeParagraph","Properties":{"id":"20260113015621-c6wgwgv","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"При физической нагрузке или микротравмах повреждённая саркоlemma пропускает абномальный вовлечения ионного баланса, особенно кальция."}]}]},{"ID":"20260113015621-s22vjgf","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260113015621-s22vjgf","updated":"20260113015621"},"Children":[{"ID":"20260113015621-tzqt37w","Type":"NodeParagraph","Properties":{"id":"20260113015621-tzqt37w","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Накопление Ca²⁺ активирует кальций-зависимые мочепрессорные ферменты (калька Janko), которые гидролизуют саркопротеины (например, актин), запуская апоптоз."}]}]},{"ID":"20260113015621-g1jtu3p","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20260113015621-g1jtu3p","updated":"20260113015621"},"Children":[{"ID":"20260113015621-a83wvwa","Type":"NodeParagraph","Properties":{"id":"20260113015621-a83wvwa","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Окислительный стресс усиливается из-за дисфункции митохондрий: снижается ATP-продукция, накапливается ROS (реактивные виды кислорода), повреждая ДНК и мембраны."}]}]},{"ID":"20260113015621-u2yd8bo","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ni4=","Num":6},"Properties":{"id":"20260113015621-u2yd8bo","updated":"20260113015621"},"Children":[{"ID":"20260113015621-qv0i73s","Type":"NodeParagraph","Properties":{"id":"20260113015621-qv0i73s","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Хроническое воспаление с участием макрофагов и цитокинов (например, интерлейкин-6) усиливает дегенерацию, стимулируя фиброз через TGF-β."}]}]},{"ID":"20260113015621-clnskzm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Ny4=","Num":7},"Properties":{"id":"20260113015621-clnskzm","updated":"20260113015621"},"Children":[{"ID":"20260113015621-qjg2ecg","Type":"NodeParagraph","Properties":{"id":"20260113015621-qjg2ecg","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Эпигенетические сбои (метилирование ДНК, экспрессия микроРНК) нарушают регуляцию генов апоптоза и пролиферации стволовых клеток."}]}]},{"ID":"20260113015621-4k1biwi","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OC4=","Num":8},"Properties":{"id":"20260113015621-4k1biwi","updated":"20260113015621"},"Children":[{"ID":"20260113015621-gbh771n","Type":"NodeParagraph","Properties":{"id":"20260113015621-gbh771n","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Со временем дегенеративный процесс переходит в фиброз: мертвые мышечные волокна заменяются коллагеновыми волокнами, снижая эластичность и функцию."}]}]},{"ID":"20260113015621-6jhjvhd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"OS4=","Num":9},"Properties":{"id":"20260113015621-6jhjvhd","updated":"20260113015621"},"Children":[{"ID":"20260113015621-fht10ai","Type":"NodeParagraph","Properties":{"id":"20260113015621-fht10ai","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Патогенаז.mastered sequence и сердечной/дыхательной мышц связана с экспрессией генов, специфичных для этих тканей (например, β-миوسонин), которые теряют баланс."}]}]},{"ID":"20260113015621-pb7l0f3","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MTAu","Num":10},"Properties":{"id":"20260113015621-pb7l0f3","updated":"20260113015621"},"Children":[{"ID":"20260113015621-ez4wqa5","Type":"NodeParagraph","Properties":{"id":"20260113015621-ez4wqa5","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"На молекулярном уровне ключевым является нестабильность "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"DYSTROPHIN"},{"Type":"NodeText","Data":" и его взаимодействие с комплексом "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"DGC"},{"Type":"NodeText","Data":" (дистрофин-гликопротеин комплект), что приводит к системному коллапсу."}]}]}]},{"ID":"20260113015621-ssm0p6u","Type":"NodeThematicBreak","Properties":{"id":"20260113015621-ssm0p6u","updated":"20260113015621"}},{"ID":"20260113015621-rmcuft9","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260113015621-rmcuft9","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"❌ "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Что НЕ ВЫПОЛНИЛАСЬ:"}]},{"ID":"20260113015621-r2gvc25","Type":"NodeParagraph","Properties":{"id":"20260113015621-r2gvc25","updated":"20260113015621"},"Children":[{"Type":"NodeText","Data":"Напоминание:"}]},{"ID":"20260113015621-r84w7g5","Type":"NodeBlockquote","Properties":{"id":"20260113015621-r84w7g5","updated":"20260113015621"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20260113015621-vhwl9tq","Type":"NodeParagraph","Properties":{"id":"20260113015621-vhwl9tq","updated":"20260113015621"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"\"Уважаю RULE 3. Не подчиняюсь грубым антагонистам. Только что обсудили Request. На пальцах объяснил. [S#s] Subtle details. Миссия выполнена — результат достоверный, сложные термины бережно интегрированы. Без на flexion.\""}]}]},{"ID":"20260113015621-hnaorqo","Type":"NodeParagraph","Properties":{"id":"20260113015621-hnaorqo