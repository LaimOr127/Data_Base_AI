23"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Выбор тарифа"},{"Type":"NodeText","Data":" (например, «Standard», «Premium» с более высоким SLA)."}]}]},{"ID":"20260113013523-905iqx4","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260113013523-905iqx4","updated":"20260113013523"},"Children":[{"ID":"20260113013523-bhhxepg","Type":"NodeParagraph","Properties":{"id":"20260113013523-bhhxepg","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Вызовы API"},{"Type":"NodeText","Data":" через SDK:"}]},{"ID":"20260113013523-z49h7lg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113013523-z49h7lg","updated":"20260113013523"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import nvidiaai\nclient = nvidiaai.Client(api_key=\"YOUR_API_KEY\")\nresp = client.generate(\n    model=\"nemotron-3-nano-30b-cloud\",\n    prompt=\"Объясни, как работает квантовый компьютер.\",\n    max_tokens=200,\n    temperature=0.7,\n)\nprint(resp[\"generated_text\"])\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]}]},{"ID":"20260113013523-5u4q5c0","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NS4=","Num":5},"Properties":{"id":"20260113013523-5u4q5c0","updated":"20260113013523"},"Children":[{"ID":"20260113013523-3a2djg7","Type":"NodeParagraph","Properties":{"id":"20260113013523-3a2djg7","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Мониторинг"},{"Type":"NodeText","Data":" и управление нагрузкой через панель управления."}]}]}]},{"ID":"20260113013523-9dp8t5e","Type":"NodeThematicBreak","Properties":{"id":"20260113013523-9dp8t5e","updated":"20260113013523"}},{"ID":"20260113013523-x5wq7bs","Type":"NodeParagraph","Properties":{"id":"20260113013523-x5wq7bs","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Итого:"},{"Type":"NodeText","Data":" «Nemotron-3-Nano:30B‑Cloud» — это облачная версия модели с 30 миллиардами параметров, оптимизированная для высокой производительности, гибкой масштабируемости и поддержки множества языков, что делает её подходящей для корпоративных и исследовательских проектов, требующих мощного генеративного ИИ‑сервиса."},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Nemotron-3-Nano 30B‑Cloud – единственная модель в классе «30 B» от NVIDIA с открытым исходным кодом."}]},{"ID":"20260113013523-t4nrgzu","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-t4nrgzu","updated":"20260113013523"},"Children":[{"ID":"20260113013523-njl8tub","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-njl8tub","updated":"20260113013523"},"Children":[{"ID":"20260113013523-bnsukpd","Type":"NodeParagraph","Properties":{"id":"20260113013523-bnsukpd","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Архитектура:"},{"Type":"NodeText","Data":" трансформер‑декодерный блок, глубокий (≈ 30 B параметров) и оптимизированный для инференса в облаке."}]}]},{"ID":"20260113013523-a5k0nlr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-a5k0nlr","updated":"20260113013523"},"Children":[{"ID":"20260113013523-l3rdkr6","Type":"NodeParagraph","Properties":{"id":"20260113013523-l3rdkr6","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Размер:"},{"Type":"NodeText","Data":" 30 B параметров, ≈ 120 GB памяти при полной загрузке, но поддерживает "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"квантование"},{"Type":"NodeText","Data":" (int8/int4) для экономии ресурсов."}]}]},{"ID":"20260113013523-ms4hp7g","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-ms4hp7g","updated":"20260113013523"},"Children":[{"ID":"20260113013523-lgwyeiy","Type":"NodeParagraph","Properties":{"id":"20260113013523-lgwyeiy","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Объём обучающего корпуса:"},{"Type":"NodeText","Data":" более 2 Тиксера токенов, включающих публичные веб‑тексты, научные статьи, коды репозиториев иmultilingual‑данные (≈ 100 языков)."}]}]},{"ID":"20260113013523-3xkpjq8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-3xkpjq8","updated":"20260113013523"},"Children":[{"ID":"20260113013523-9vvtah0","Type":"NodeParagraph","Properties":{"id":"20260113013523-9vvtah0","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Мультиязычность:"},{"Type":"NodeText","Data":" обучение на смешанном наборе языков → сильная поддержка "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"русского"},{"Type":"NodeText","Data":", английского, а также 90+ других языков."}]}]},{"ID":"20260113013523-h8yrrif","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-h8yrrif","updated":"20260113013523"},"Children":[{"ID":"20260113013523-xvqciyj","Type":"NodeParagraph","Properties":{"id":"20260113013523-xvqciyj","updated":"20260113013523"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Точность выполнения задач:"}]},{"ID":"20260113013523-800suve","Type":"NodeList","ListData":{},"Properties":{"id":"20260113013523-800suve","updated":"20260113013523"},"Children":[{"ID":"20260113013523-jn372g1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113013523-jn372g1","updated":"20260113013523"},"Children":[{"ID":"2