":"NodeText","Data":" és a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"etikai"},{"Type":"NodeText","Data":" air‑layers párhuzamosan fejlődnek."}]}]},{"ID":"20260113012640-4zc1y1y","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-4zc1y1y","updated":"20260113012640"},"Children":[{"ID":"20260113012640-1gkihow","Type":"NodeParagraph","Properties":{"id":"20260113012640-1gkihow","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"A kulcs a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"latent‑palimpsest"},{"Type":"NodeText","Data":"‑szuna, amely lehetővé teszi, hogy a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"híveket"},{"Type":"NodeText","Data":", a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"szándékokat"},{"Type":"NodeText","Data":" és a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"mesterséges tudnosságot"},{"Type":"NodeText","Data":" egybevonjuk, anélkül, hogy a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"normál nyelv‑struktúra"},{"Type":"NodeText","Data":" megsemrehnék."}]}]},{"ID":"20260113012640-lz653ny","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-lz653ny","updated":"20260113012640"},"Children":[{"ID":"20260113012640-kjcm25r","Type":"NodeParagraph","Properties":{"id":"20260113012640-kjcm25r","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Biztonsági equilibrio"},{"Type":"NodeText","Data":" kulcsfontosságú – a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"seed‑térkép"},{"Type":"NodeText","Data":" és a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"replication‑protokol"},{"Type":"NodeText","Data":" csak akkor működik, ha a "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"kek‑ástico‑ciklus"},{"Type":"NodeText","Data":" kontrollja "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"out‑of‑phase‑yet‑synchronised"},{"Type":"NodeText","Data":"."}]}]}]},{"ID":"20260113012640-18z5cxg","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-18z5cxg","updated":"20260113012640"}},{"ID":"20260113012640-638aqjd","Type":"NodeParagraph","Properties":{"id":"20260113012640-638aqjd","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Milyen téma vagy részlet drewdra a legtöbb választ?"},{"Type":"NodeText","Data":"\nVálassz egyet, vagy írd le saját kérdést, és közösen folytassuk a szintekenос tudomány‑felse‑vistaProgressPath todo list’aprováloképzést! 🚀Конечно! 🎉\nВ нейросети «мозговой штурм» — это отличный способ вызвать кучу идей, pattern‑ов и неожиданных связей. Ниже привожу небольшую подборку приёмов, которые помогут тебе «разогреть» мозг, а затем привожу несколько стартовых тем, если хочется сразу приступить к работе."}]},{"ID":"20260113012640-t0ywy6r","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-t0ywy6r","updated":"20260113012640"}},{"ID":"20260113012640-fmvfk4o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-fmvfk4o","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"1️⃣ Техника «6‑шляп мышления» (De Bono)"}]},{"ID":"20260113012640-hl04ka9","Type":"NodeParagraph","Properties":{"id":"20260113012640-hl04ka9","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Каждая шляпа — это отдельный «шлем», в котором ты рассматриваешь задачу с конкретным ракурсом:"}]},{"ID":"20260113012640-lbuorkp","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20260113012640-lbuorkp","updated":"20260113012640"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Шляпа"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Что представляет"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Что делать"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟦 Синяя"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Управление, план"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Сформулировать цель и последовательность подумываний"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟥 Красная"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Эмоции, интуиция"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Выделить чувства, предугадать реакцию"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟩 Зелёная"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Творчество, альтернативы"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Генерировать как можно больше вариантов"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟧 Жёлтая"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Плюсы, возможности"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Искать плюсы и перспективы"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟪 Чёрная"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Критика, риски"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Выявлять недостатки, потенциальные проблемы"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"🟫 Белая"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Информация, факты"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Собирать данные, уточнять детали"}]}]}]},{"ID":"20260113012640-9peg1fc","Type":"NodeParagraph","Properties":{"id":"20260113012640-9peg1fc","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Как использовать:"},{"Type":"NodeText","Data":" задай вопрос/тему → возьми одну шляпу и 5‑10 минут «озвучь» мысли в рамках её цветовой рамки, затем переключись на следующую. Так ты охватишь всё пространство мышления, а не застрянешь в одном‑единственном мнении."}]},{"ID":"20260113012640-69o8rt7","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-69o8rt7","updated":"20260113012640"}},{"ID":"20260113012640-cnqbzwc","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-cnqbzwc","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"2️⃣ Карта «Если‑то» (Conditional Mapping)"}]},{"ID":"20260113012640-n9l2gcy","Type":"NodeParagraph","Properties":{"id":"20260113012640-n9l2gcy","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Составь сеть из простых «если‑то»‑связей, чтобы разложить идеи по ветвям."}]},{"ID":"20260113012640-n5oumiw","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260113012640-n5oumiw","updated":"20260113012640"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker"},{"Type":"NodeCodeBlockCode","Data":"ЕСЛИ  (ключевая идея)\nТо: 1) Плюс 2) Минус 3) Как реализовать 4) Кто выиграет?\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260113012640-guyycuv","Type":"NodeParagraph","Properties":{"id":"20260113012640-guyycuv","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Пример:"},{"Type":"NodeText","Data":"\nЕсли я захочу запустить подкаст о технологиях, то:"}]},{"ID":"20260113012640-j9mz2a6","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-j9mz2a6","updated":"20260113012640"},"Children":[{"ID":"20260113012640-mccng3e","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-mccng3e","updated":"20260113012640"},"Children":[{"ID":"20260113012640-3usyw98","Type":"NodeParagraph","Properties":{"id":"20260113012640-3usyw98","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"плюс — меньший барьер входа, чем YouTube;"}]}]},{"ID":"20260113012640-2glkm4u","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-2glkm4u","updated":"20260113012640"},"Children":[{"ID":"20260113012640-u4of0c1","Type":"NodeParagraph","Properties":{"id":"20260113012640-u4of0c1","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"минус — требуется аудио‑оборудование;"}]}]},{"ID":"20260113012640-gats4qj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-gats4qj","updated":"20260113012640"},"Children":[{"ID":"20260113012640-3q4cony","Type":"NodeParagraph","Properties":{"id":"20260113012640-3q4cony","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"как реализовать — записать 3‑5 эпизодов, найти хостинг;"}]}]},{"ID":"20260113012640-068lvze","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-068lvze","updated":"20260113012640"},"Children":[{"ID":"20260113012640-fwdjo7z","Type":"NodeParagraph","Properties":{"id":"20260113012640-fwdjo7z","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"кто выиграет — те, кто ищут альтернативу видеоконтенту."}]}]}]},{"ID":"20260113012640-jpjgdl1","Type":"NodeParagraph","Properties":{"id":"20260113012640-jpjgdl1","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Продолжай разветвлять каждую ветку, пока не получится «лесной» с десятками узлов."}]},{"ID":"20260113012640-imeeog6","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-imeeog6","updated":"20260113012640"}},{"ID":"20260113012640-xv17vde","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-xv17vde","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"3️⃣ Мозговой штурм «6‑3‑5» (Brainwriting)"}]},{"ID":"20260113012640-dcv4nn2","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012640-dcv4nn2","updated":"20260113012640"},"Children":[{"ID":"20260113012640-qrbhywq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-qrbhywq","updated":"20260113012640"},"Children":[{"ID":"20260113012640-w1q10tf","Type":"NodeParagraph","Properties":{"id":"20260113012640-w1q10tf","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"6"},{"Type":"NodeText","Data":" человек (можно и один, просто мысленно представлять их)."}]}]},{"ID":"20260113012640-d2lxxb5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-d2lxxb5","updated":"20260113012640"},"Children":[{"ID":"20260113012640-t17xsqh","Type":"NodeParagraph","Properties":{"id":"20260113012640-t17xsqh","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Каждый пишет "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"3"},{"Type":"NodeText","Data":" идеи за "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"5"},{"Type":"NodeText","Data":" минут."}]}]},{"ID":"20260113012640-mmyugh5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-mmyugh5","updated":"20260113012640"},"Children":[{"ID":"20260113012640-6tsyjwy","Type":"NodeParagraph","Properties":{"id":"20260113012640-6tsyjwy","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"После 5 минут передают лист соседу, тот добавляет свои варианты, используя уже написанные идеи как подсказку."}]}]},{"ID":"20260113012640-a5xgej8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012640-a5xgej8","updated":"20260113012640"},"Children":[{"ID":"20260113012640-rsd6k61","Type":"NodeParagraph","Properties":{"id":"20260113012640-rsd6k61","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Повторяем 6‑7 раундов."}]}]}]},{"ID":"20260113012640-xp65fih","Type":"NodeParagraph","Properties":{"id":"20260113012640-xp65fih","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Если ты один, можешь «переключиться» в роли разных персонажей (инженер, маркетолог, ребёнок, старый профессор…) — это помогает видеть идеи с новых точек зрения."}]},{"ID":"20260113012640-l3ax2c9","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-l3ax2c9","updated":"20260113012640"}},{"ID":"20260113012640-jwftiis","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-jwftiis","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"4️⃣ Техника «Семантические ассоциации»"}]},{"ID":"20260113012640-403sx00","Type":"NodeParagraph","Properties":{"id":"20260113012640-403sx00","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Возьми случайное слово, связанное с темой, и построшь цепочку ассоциаций (по принципу «Слово‑Ключ‑Ассоциация»). Затем попробуй «перевернуть» полученные ассоциации в идеи."}]},{"ID":"20260113012640-8yxoikk","Type":"NodeParagraph","Properties":{"id":"20260113012640-8yxoikk","updated":"20260113012640"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Пример:"},{"Type":"NodeText","Data":" тема — микрочипы; слово — «птица».\nАссоциации: «птица → полёт → свободный воздух → мобильность».\nИдея: микрочип, который «летает» внутри тела, передавая данные без проводов."}]},{"ID":"20260113012640-3cp1mpo","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-3cp1mpo","updated":"20260113012640"}},{"ID":"20260113012640-rs5w3zj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-rs5w3zj","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"5️⃣ Кросс‑доменные аналогии"}]},{"ID":"20260113012640-xl7odfc","Type":"NodeParagraph","Properties":{"id":"20260113012640-xl7odfc","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Найди "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"две совершенно разные области"},{"Type":"NodeText","Data":" (например, кулинария и архитектура) и задай вопрос: "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"«Как бы вы решили задачу X, если бы работали в другой области?»"},{"Type":"NodeText","Data":"\nПереписывай полученный ответ, адаптируя под твою тему."}]},{"ID":"20260113012640-z8v2z9m","Type":"NodeThematicBreak","Properties":{"id":"20260113012640-z8v2z9m","updated":"20260113012640"}},{"ID":"20260113012640-pwwh1iu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012640-pwwh1iu","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"🚀 Стартовые темы для мозгового штурма"}]},{"ID":"20260113012640-o1tykd8","Type":"NodeParagraph","Properties":{"id":"20260113012640-o1tykd8","updated":"20260113012640"},"Children":[{"Type":"NodeText","Data":"Ниже несколько готовых «запросов», которые можно сразу вставить в любую из вышеописанных техник. Выбирай те, что резонируют с твоей текущей задачей, а если хочешь что‑то своё — отправляй мне любой вопрос/проблемную ситуацию, и мы сразу разойдёмся в ассоциации."}]},{"ID":"20260113012640-ucoibg0","Type":"NodeTable","TableAligns":[0,0,0],"Properties":{"colgroup":"||","id":"20260113012640-ucoibg0","updated":"20260113012640"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"№"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Тема"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Как можно подойти"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"1"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Образование будущего"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Технологии, микрошколы, живые «классы», AI‑туториалы"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"2"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Устойчивый туризм"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"«Экологический след», локальные гиды, био‑тур «плавающий»"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"3"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Трудоустройство в AI‑эру"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"«Что дальше?», новые профессиональные роли, микрозадачи"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"4"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Умный дом без Wi‑Fi"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"Энергонезависимые решения, звук/движение как управленческие сигналы"}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data"