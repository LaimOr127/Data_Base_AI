"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20260113012804-rl4lvns","Type":"NodeParagraph","Properties":{"id":"20260113012804-rl4lvns","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Для каждой действия силы существует равная по модулю, но противоположного по направлению, реактивная сила."}]}]},{"ID":"20260113012804-f5mwshf","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-f5mwshf","updated":"20260113012804"},"Children":[{"ID":"20260113012804-r3uvf5k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-r3uvf5k","updated":"20260113012804"},"Children":[{"ID":"20260113012804-aeeluin","Type":"NodeParagraph","Properties":{"id":"20260113012804-aeeluin","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Обозначение:"},{"Type":"NodeText","Data":" "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\mathbf{F}_{12} = -\\mathbf{F}_{21}"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":"."}]}]},{"ID":"20260113012804-p86jbop","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-p86jbop","updated":"20260113012804"},"Children":[{"ID":"20260113012804-dw3pwsi","Type":"NodeParagraph","Properties":{"id":"20260113012804-dw3pwsi","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Что это значит:"}]},{"ID":"20260113012804-qye028w","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-qye028w","updated":"20260113012804"},"Children":[{"ID":"20260113012804-m397z1i","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-m397z1i","updated":"20260113012804"},"Children":[{"ID":"20260113012804-8wtfrna","Type":"NodeParagraph","Properties":{"id":"20260113012804-8wtfrna","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Если тело A давит на тело B с силой "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"("}]},{"Type":"NodeText","Data":"\\mathbf{F}"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":")"}]},{"Type":"NodeText","Data":", то тело B одновременно давит на A с силой такой же величины, но противоположного направления."}]}]}]}]},{"ID":"20260113012804-cxsej69","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-cxsej69","updated":"20260113012804"},"Children":[{"ID":"20260113012804-7a4g4xo","Type":"NodeParagraph","Properties":{"id":"20260113012804-7a4g4xo","updated":"20260113012804"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Парадоксы и оговорки:"}]},{"ID":"20260113012804-ln0b433","Type":"NodeList","ListData":{},"Properties":{"id":"20260113012804-ln0b433","updated":"20260113012804"},"Children":[{"ID":"20260113012804-0gs5w59","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-0gs5w59","updated":"20260113012804"},"Children":[{"ID":"20260113012804-g02ztf8","Type":"NodeParagraph","Properties":{"id":"20260113012804-g02ztf8","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Силы действуют на разные тела, поэтому они не «настраивают» друг друга в одном и том же системе; однако в замкнутом системе общая сумма всех сил равна нулю."}]}]},{"ID":"20260113012804-0ltctgm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260113012804-0ltctgm","updated":"20260113012804"},"Children":[{"ID":"20260113012804-365joow","Type":"NodeParagraph","Properties":{"id":"20260113012804-365joow","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"При взаимодействии soumisных тел (например, при соприкосновении колёс и дороги) реактивная сила проявляется в виде трения, позволяющего автомобилю «толкаться» вперёд."}]}]}]}]}]},{"ID":"20260113012804-ynu6tg5","Type":"NodeThematicBreak","Properties":{"id":"20260113012804-ynu6tg5","updated":"20260113012804"}},{"ID":"20260113012804-kdpj903","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260113012804-kdpj903","updated":"20260113012804"},"Children":[{"Type":"NodeText","Data":"Как использовать законы Ньютона в задачах"}]},{"ID":"20260113012804-2w4eq88","Type":"NodeTable","TableAligns":[0,0],"Properties":{"colgroup":"|","id":"20260113012804-2w4eq88","updated":"20260113012804"},"Children":[{"Type":"NodeTableHead","Data":"thead","Children":[{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Шаг"}]},{"Type":"NodeTableCell","Data":"th","Children":[{"Type":"NodeText","Data":"Что делаем"}]}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"1️⃣"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Определяем систему"},{"Type":"NodeText","Data":" (выбираем «тело», на которое будем действовать силы)."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"2️⃣"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"СоставляемFree‑body diagram"},{"Type":"NodeText","Data":" – рисуем векторные стрелочки всех внешних сил, действующих на выбранное тело."}]}]},{"Type":"NodeTableRow","Data":"tr","Children":[{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeText","Data":"3️⃣"}]},{"Type":"NodeTableCell","Data":"td","Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Применяем второй закон"},{"Type":"NodeText","Data":": "},{"Type":"NodeBackslash","Data":"spa